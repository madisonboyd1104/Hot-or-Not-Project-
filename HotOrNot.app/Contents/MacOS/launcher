#!/bin/bash
# HotOrNot Sentiment Analyzer - Application Launcher

# Get the directory of the app bundle
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
WORK_DIR="$APP_DIR"

# Change to the working directory
cd "$WORK_DIR"

# Suppress macOS Tkinter deprecation warning
export TK_SILENCE_DEPRECATION=1

# Check if virtual environment exists in current or parent directory
if [ -d "venv" ]; then
    PYTHON_PATH="venv/bin/python"
elif [ -d "../tt5.1/venv" ]; then
    PYTHON_PATH="../tt5.1/venv/bin/python"
else
    osascript -e 'display alert "Virtual Environment Not Found" message "Please install dependencies first:\n\npython3 -m venv venv\nvenv/bin/pip install -r requirements.txt" as critical'
    exit 1
fi

# Run the application
"$PYTHON_PATH" main.py 2>&1 | tee /tmp/hotornot.log

# Show error if app crashed
if [ $? -ne 0 ]; then
    osascript -e 'display alert "Application Error" message "HotOrNot encountered an error. Check /tmp/hotornot.log for details." as critical'
fi

